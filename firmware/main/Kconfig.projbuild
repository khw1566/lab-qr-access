menu "Lab Door Config"

    menu "Wi-Fi / Server"
        config LAB_WIFI_SSID
            string "Wi-Fi SSID (실습실 Wi-Fi 이름)"
            default "LAB-WIFI"
        config LAB_WIFI_PASSWORD
            string "Wi-Fi password (개방형이면 비워 두기)"
            default ""
        config LAB_SERVER_URL
            string "Server base URL (끝에 / 없이)"
            default "https://lab.audreaming.com"
        config LAB_DEVICE_KEY
            string "Device key (관리자 화면 > 단말 등록에서 발급)"
            default ""
        config LAB_ADMIN_PIN
            string "단말 설정 화면 비밀번호 (저장소에 올리지 말고 sdkconfig에만 둘 것)"
            default ""
    endmenu

    menu "Board pins (JC1060P470C)"
        config LAB_I2C_SDA
            int "Shared I2C SDA (touch / camera / 4P I2C)"
            default 7
        config LAB_I2C_SCL
            int "Shared I2C SCL"
            default 8
        config LAB_CAM_RESET_GPIO
            int "Camera reset GPIO (-1 = none)"
            default -1
        config LAB_CAM_PWDN_GPIO
            int "Camera power-down GPIO (-1 = none)"
            default -1
        config LAB_LCD_RESET_GPIO
            int "LCD reset GPIO"
            default 0
        config LAB_LCD_BACKLIGHT_GPIO
            int "LCD backlight GPIO"
            default 23
        config LAB_AUDIO_MCLK_GPIO
            int "ES8311 I2S MCLK GPIO"
            default 13
        config LAB_AUDIO_BCLK_GPIO
            int "ES8311 I2S BCLK GPIO"
            default 12
        config LAB_AUDIO_WS_GPIO
            int "ES8311 I2S LRCK GPIO"
            default 10
        config LAB_AUDIO_DOUT_GPIO
            int "ES8311 I2S speaker data GPIO"
            default 9
        config LAB_AUDIO_AMP_GPIO
            int "Speaker amplifier enable GPIO"
            default 11
    endmenu

    menu "Door relay"
        config LAB_RELAY_GPIO
            int "Relay control GPIO (헤더의 빈 핀: 1,2,3,4,20,32,33,45,46,47)"
            default 32
        config LAB_RELAY_ACTIVE_HIGH
            bool "Relay is active-high"
            default y

        config LAB_DOOR_MAX_OPEN_MS
            int "Max door open pulse (ms)"
            default 10000
        config LAB_BUZZER_GPIO
            int "Status buzzer/LED GPIO (-1 = 사용 안 함)"
            default -1
    endmenu
endmenu
