{
  "name": "lab-access-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lab-access --local",
    "db:migrate": "wrangler d1 migrations apply lab-access --remote",
    "local:start": "node --disable-warning=ExperimentalWarning node/server.js",
    "local:backup": "node --disable-warning=ExperimentalWarning node/backup.js",
    "local:import": "node --disable-warning=ExperimentalWarning node/import-d1.js",
    "local:test": "node --disable-warning=ExperimentalWarning --test node/test/*.test.js"
  },
  "devDependencies": {
    "qrcode-generator": "^1.4.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
