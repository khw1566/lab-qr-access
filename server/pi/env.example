# server/.env 로 복사해서 값을 채우세요 (cp pi/env.example .env). 이 파일은 git에 올리지 않습니다.

# Cloudflare에 secret으로 등록했던 값과 똑같이 넣어야 기존 로그인과 QR이 그대로 유지됩니다.
SESSION_SECRET=
QR_SECRET=
ADMIN_SETUP_CODE=

REQUIRE_USER_APPROVAL=false
DOOR_OPEN_MS=3000

# 외부(터널) 포트: cloudflared 가 http://localhost:8787 로 연결합니다.
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8787

# 내부(단말) 포트: 보드가 http://<파이IP>:8788 로 직접 연결합니다.
DEVICE_HOST=0.0.0.0
DEVICE_PORT=8788
# 단말 포트에 들어올 수 있는 주소 앞부분 (쉼표 구분, 비우면 모두 허용). 예: 192.168.0.
DEVICE_ALLOW=
# 1로 바꾸면 터널(외부)로도 단말 API를 받습니다. 내부망 장애 때만 임시로.
DEVICE_API_PUBLIC=0

DB_FILE=data/lab-access.sqlite
BACKUP_DIR=data/backups
BACKUP_KEEP_DAYS=14
