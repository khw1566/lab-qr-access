{
  "name": "lab-access",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // 학생/관리자 웹앱과 보드 API를 lab.audreaming.com 에서 서비스 (Cloudflare가 DNS와 인증서를 자동 생성)
  "routes": [{ "pattern": "lab.audreaming.com", "custom_domain": true }],
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "lab-access", "database_id": "c2076680-7ed6-4728-9c2e-e5df5f657f94" }
  ],
  // 관리자 실시간 보기(단말 카메라·음성) 중계. 단말마다 객체 하나. SQLite 방식이라 무료 요금제에서도 쓸 수 있다.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRelay" }]
  },
  "migrations": [{ "tag": "v1-live", "new_sqlite_classes": ["LiveRelay"] }],
  "vars": {
    "REQUIRE_USER_APPROVAL": "false",
    "DOOR_OPEN_MS": "3000"
  }
  // 비밀값은 vars가 아니라 secret으로 등록:
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put QR_SECRET
  //   npx wrangler secret put ADMIN_SETUP_CODE   (첫 관리자 가입용 코드)
}
